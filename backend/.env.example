# ============================================================================
# AI Interview Coach - Backend Environment Configuration
# ============================================================================

# Database
POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/interview_db
REDIS_URL=redis://localhost:6379

# JWT Secret (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=your-secret-key-change-this-in-production

# ============================================================================
# LLM Provider APIs
# ============================================================================

# Google Gemini (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq API Key for speech transcription and LLM fallback
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# ============================================================================
# Stripe (Payment)
# ============================================================================

STRIPE_PUBLISHABLE_KEY=placeholder
STRIPE_SECRET_KEY=

# ============================================================================
# OAuth2 - Google Sign-In
# ============================================================================
# Setup: https://console.cloud.google.com/
# Get Client ID from: APIs & Services > Credentials > OAuth 2.0 Client ID (Web)
# Documentation: docs/OAUTH2_SETUP.md

GOOGLE_OAUTH_CLIENT_ID=

# ============================================================================
# OAuth2 - Apple Sign In
# ============================================================================
# Setup: https://developer.apple.com/
# Requires:
# 1. Apple Developer Account
# 2. App ID with "Sign in with Apple" capability
# 3. Service ID (Web)
# 4. Private key for the Service ID
# Documentation: docs/OAUTH2_SETUP.md

APPLE_OAUTH_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# ============================================================================
# OAuth2 - Facebook Login
# ============================================================================
# Setup: https://developers.facebook.com/
# Get App ID and App Secret from: Settings > Basic
# Documentation: docs/OAUTH2_SETUP.md

FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=
