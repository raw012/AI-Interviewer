# Never commit real keys to Git. All of these are optional: users can connect
# their own provider keys in Settings, stored encrypted per account.

# Server-wide fallback keys
GROQ_API_KEY=your_groq_api_key_here
# ELEVENLABS_API_KEY=

# Google sign-in: OAuth client ID (Web application) from Google Cloud Console.
# Add your site origin under "Authorised JavaScript origins".
# GOOGLE_CLIENT_ID=

# Live web search for role briefs (either one)
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# Extra allowed browser origins for local development, comma separated
# ALLOWED_ORIGINS=http://localhost:3000
